---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SceneRunner from '../../components/SceneRunner.astro';
import { chapters } from '../../story';

export function getStaticPaths() {
  return chapters.map((chapter) => ({
    params: { chapter: chapter.id },
    props: { chapter }
  }));
}

const { chapter } = Astro.props;
---
<BaseLayout title={chapter.title} description={chapter.intro}>
  <p class="text-xs uppercase tracking-widest text-[var(--color-muted)] mb-1">
    Chapter
  </p>
  <h1 class="text-2xl md:text-3xl font-bold tracking-tight mb-6">
    {chapter.title}
  </h1>
  <SceneRunner chapter={chapter} />
</BaseLayout>
