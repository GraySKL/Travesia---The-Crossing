---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Offline">
  <section class="py-8">
    <h1 class="text-2xl font-bold mb-3">You're offline</h1>
    <p class="text-[var(--color-muted)] max-w-prose">
      Travesía works offline once it's loaded. Reconnect to load something new,
      or return to a chapter you've already opened — your progress is saved on
      this device.
    </p>
    <p class="mt-4">
      <a class="underline text-[var(--color-accent)]" href="/">Back to start</a>
    </p>
  </section>
</BaseLayout>
